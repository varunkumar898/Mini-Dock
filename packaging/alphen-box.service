[Unit]
Description=Alphen OS Container Runtime Service
Documentation=https://github.com/alphen-os/alphen-box
After=network.target local-fs.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/libexec/alphen-box/alphen-box-setup.sh
ExecStart=/usr/bin/alphen-box ps -a
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes

[Install]
WantedBy=multi-user.target
